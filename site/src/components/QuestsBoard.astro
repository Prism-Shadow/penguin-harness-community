---
import type { Locale } from "../shared/i18n";
import {
  QUESTS,
  QUEST_DOMAINS,
  buildProposeTaskIssueUrl,
  resolveText,
  type QuestDomainId,
  type QuestItem,
  type QuestStatus,
} from "../shared/community";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const COPY = {
  zh: {
    title: "任务板",
    propose: "发布任务（仅限委员会成员）↗",
    colOpen: "待认领",
    colInProgress: "进行中",
    colCompleted: "已完成",
    unclaimed: "待认领",
    details: "详情",
    empty: "暂无任务",
    modalTargetRepo: "目标仓库",
    modalLinkedPr: "提交 PR",
    modalRelatedIssue: "关联 Issue",
    modalRefs: "原始论文与代码仓库",
    modalClaimHint: "请直接在该任务的 GitHub Issue 下方评论回复 /claim 完成认领：",
    modalClaimBtn: "打开任务 Issue (#",
    modalClaimBtnSuffix: ") 回复认领 ↗",
    modalCompletedHint: "该任务已完成并通过审核合入：",
    modalPrBtn: "查看提交 PR (#",
    modalPrBtnSuffix: ") ↗",
    modalClose: "关闭",
  },
  en: {
    title: "Quests",
    propose: "Propose Task (Committee Only) ↗",
    colOpen: "Open",
    colInProgress: "In Progress",
    colCompleted: "Completed",
    unclaimed: "Unclaimed",
    details: "Details",
    empty: "No tasks",
    modalTargetRepo: "Target Repository",
    modalLinkedPr: "Pull Request",
    modalRelatedIssue: "Related Issue",
    modalRefs: "Original Papers & Repositories",
    modalClaimHint: "Reply /claim under this task's GitHub Issue to claim it:",
    modalClaimBtn: "Open Task Issue (#",
    modalClaimBtnSuffix: ") to Claim ↗",
    modalCompletedHint: "This task has been completed and merged:",
    modalPrBtn: "View Pull Request (#",
    modalPrBtnSuffix: ") ↗",
    modalClose: "Close",
  },
}[locale];

const STAGES: { key: QuestStatus; label: string }[] = [
  { key: "open", label: COPY.colOpen },
  { key: "in_progress", label: COPY.colInProgress },
  { key: "completed", label: COPY.colCompleted },
];

function tasksFor(domain: QuestDomainId, status: QuestStatus): QuestItem[] {
  return QUESTS.filter((q) => q.domain === domain && q.status === status);
}
---

<div class="mx-auto w-full max-w-5xl px-6 py-12" data-quests-root>
  <header class="flex items-baseline justify-between gap-4 pb-8">
    <h1 class="text-3xl font-semibold tracking-tight text-gray-950 dark:text-white">
      {COPY.title}
    </h1>
    <a
      href={buildProposeTaskIssueUrl()}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm text-gray-500 transition-colors hover:text-gray-950 dark:text-gray-400 dark:hover:text-white"
    >
      {COPY.propose}
    </a>
  </header>

  <!-- Domain-Grouped Kanban: Domain as Section Header, Equal-Width 3 Columns for Progress -->
  <div class="space-y-10">
    {
      QUEST_DOMAINS.map((domain) => (
        <section class="border-t border-gray-200 pt-5 dark:border-gray-800">
          <h2 class="mb-4 text-lg font-semibold tracking-tight text-gray-950 dark:text-white">
            {domain.label[locale]}
          </h2>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            {STAGES.map((stage) => {
              const items = tasksFor(domain.id, stage.key);
              return (
                <div class="flex min-w-0 flex-col rounded-xl border border-gray-200/80 bg-gray-50/50 p-3 dark:border-gray-800/80 dark:bg-gray-900/30">
                  <div class="mb-2.5 flex items-center justify-between px-1 text-xs font-medium text-gray-500 dark:text-gray-400">
                    <span>{stage.label}</span>
                    <span class="mono">{items.length}</span>
                  </div>

                  {items.length === 0 ? (
                    <div class="flex flex-1 items-center justify-center py-6 text-xs text-gray-400 dark:text-gray-600">
                      {COPY.empty}
                    </div>
                  ) : (
                    <div class="space-y-2.5">
                      {items.map((q) => (
                        <button
                          type="button"
                          data-quest-open={q.id}
                          class="group block w-full cursor-pointer rounded-lg border border-gray-200 bg-white p-3.5 text-left shadow-2xs transition-colors hover:border-brand-500 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-brand-500"
                        >
                          <div class="flex items-start justify-between gap-2.5">
                            <span class="text-sm font-medium leading-snug text-gray-950 group-hover:text-brand-600 dark:text-gray-100 dark:group-hover:text-brand-400">
                              {resolveText(q.title, locale)}
                            </span>
                            <span class="mono shrink-0 rounded-md bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-700 ring-1 ring-inset ring-brand-600/20 dark:bg-brand-950/80 dark:text-brand-300 dark:ring-brand-400/30">
                              +{q.exp} EXP
                            </span>
                          </div>

                          <div class="mt-2.5 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                            <span class="mono">
                              {q.issueNumber ? `#${q.issueNumber}` : `PR #${q.prNumber}`} · {q.assignee ? `@${q.assignee}` : COPY.unclaimed}
                            </span>
                            <span class="text-brand-600 group-hover:underline dark:text-brand-400">
                              {COPY.details} →
                            </span>
                          </div>
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>

  <!-- Task Detail Modals -->
  {
    QUESTS.map((q) => {
      const domainLabel = QUEST_DOMAINS.find((d) => d.id === q.domain)?.label[locale] ?? q.domain;
      const stageLabel = STAGES.find((s) => s.key === q.status)?.label ?? q.status;
      return (
        <dialog
          data-quest-dialog={q.id}
          class="site-leave m-auto w-[calc(100%-2rem)] max-w-lg text-left"
        >
          <div class="site-leave-body">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="mono text-xs text-gray-500 dark:text-gray-400">
                  {domainLabel} · {stageLabel} · {q.issueNumber ? `Issue #${q.issueNumber}` : `PR #${q.prNumber}`}{q.assignee ? ` · @${q.assignee}` : ""}
                </div>
                <h2 class="mt-1 text-lg font-semibold tracking-tight text-gray-950 dark:text-white">
                  {resolveText(q.title, locale)}
                </h2>
              </div>
              <span class="mono shrink-0 rounded-md bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700 ring-1 ring-inset ring-brand-600/20 dark:bg-brand-950/80 dark:text-brand-300 dark:ring-brand-400/30">
                +{q.exp} EXP
              </span>
            </div>

            <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {resolveText(q.description, locale)}
            </p>

            <div class="mt-4">
              <div class="text-xs font-medium text-gray-500 dark:text-gray-400">
                {COPY.modalTargetRepo}
              </div>
              <div class="mt-1 text-xs">
                <a
                  href={q.targetRepository}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mono break-all text-brand-600 underline decoration-brand-300 underline-offset-2 hover:text-brand-500 dark:text-brand-400 dark:decoration-brand-700"
                >
                  {q.targetRepository}
                </a>
              </div>
            </div>

            {q.linkedPr && (
              <div class="mt-3">
                <div class="text-xs font-medium text-gray-500 dark:text-gray-400">
                  {COPY.modalLinkedPr}
                </div>
                <div class="mt-1 text-xs">
                  <a
                    href={q.linkedPr}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mono break-all text-brand-600 underline decoration-brand-300 underline-offset-2 hover:text-brand-500 dark:text-brand-400 dark:decoration-brand-700"
                  >
                    {q.linkedPr}
                  </a>
                </div>
              </div>
            )}

            {q.relatedIssue && (
              <div class="mt-3">
                <div class="text-xs font-medium text-gray-500 dark:text-gray-400">
                  {COPY.modalRelatedIssue}
                </div>
                <div class="mt-1 text-xs">
                  <a
                    href={q.relatedIssue}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mono break-all text-brand-600 underline decoration-brand-300 underline-offset-2 hover:text-brand-500 dark:text-brand-400 dark:decoration-brand-700"
                  >
                    {q.relatedIssue}
                  </a>
                </div>
              </div>
            )}

            {q.references.length > 0 && (
              <div class="mt-3">
                <div class="text-xs font-medium text-gray-500 dark:text-gray-400">
                  {COPY.modalRefs}
                </div>
                <ul class="mt-1.5 space-y-1 text-xs">
                  {q.references.map((ref) => (
                    <li>
                      <a
                        href={ref.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mono break-all text-brand-600 underline decoration-brand-300 underline-offset-2 hover:text-brand-500 dark:text-brand-400 dark:decoration-brand-700"
                      >
                        {ref.url}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="mt-5 border-t border-gray-200 pt-4 dark:border-gray-800">
              <p class="text-xs text-gray-500 dark:text-gray-400">
                {q.status === "completed" ? COPY.modalCompletedHint : COPY.modalClaimHint}
              </p>
              <div class="mt-3 flex flex-wrap justify-end gap-2">
                <button
                  type="button"
                  data-quest-close
                  class="site-leave-cancel inline-flex h-9 items-center justify-center px-4 text-sm font-medium"
                >
                  {COPY.modalClose}
                </button>
                {q.status === "completed" && q.linkedPr ? (
                  <a
                    href={q.linkedPr}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="site-leave-open inline-flex h-9 items-center justify-center gap-1.5 px-4 text-sm font-semibold"
                  >
                    <span>
                      {COPY.modalPrBtn}{q.prNumber}{COPY.modalPrBtnSuffix}
                    </span>
                  </a>
                ) : (
                  <a
                    href={q.issueUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="site-leave-open inline-flex h-9 items-center justify-center gap-1.5 px-4 text-sm font-semibold"
                  >
                    <span>
                      {COPY.modalClaimBtn}{q.issueNumber}{COPY.modalClaimBtnSuffix}
                    </span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </dialog>
      );
    })
  }
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-quests-root]");
  if (root) {
    root.querySelectorAll<HTMLButtonElement>("[data-quest-open]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.questOpen;
        const dialog = root.querySelector<HTMLDialogElement>(`[data-quest-dialog="${id}"]`);
        if (dialog && !dialog.open) {
          dialog.showModal();
        }
      });
    });

    root.querySelectorAll<HTMLDialogElement>("[data-quest-dialog]").forEach((dialog) => {
      let pressedBackdrop = false;
      dialog.querySelector<HTMLButtonElement>("[data-quest-close]")?.addEventListener("click", () => {
        dialog.close();
      });
      dialog.addEventListener("pointerdown", (e) => {
        pressedBackdrop = e.target === dialog;
      });
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog && pressedBackdrop) dialog.close();
      });
    });
  }
</script>
