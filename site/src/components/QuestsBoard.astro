              </div>

              <!-- Action Row -->
              <div class="mt-3.5 flex flex-wrap items-center justify-between gap-2">
                {quest.status === "open" ? (
                  <div class="flex flex-wrap items-center gap-2">
                    <a
                      href={buildClaimIssueUrl(quest, locale)}
