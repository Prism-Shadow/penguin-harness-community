<style>
  .quest-status-btn,
  .quest-cat-btn {
    border: 1px solid var(--color-gray-200, #e5e7eb);
    background: transparent;
    color: var(--color-gray-600, #4b5563);
  }
  :global(.dark) .quest-status-btn,
  :global(.dark) .quest-cat-btn {
    border-color: #1f2937;
    color: #9ca3af;
  }
  .quest-status-btn.is-active,
  .quest-cat-btn.is-active {
    background: #111827;
    color: #ffffff;
    border-color: #111827;
  }
  :global(.dark) .quest-status-btn.is-active,
  :global(.dark) .quest-cat-btn.is-active {
    background: #ffffff;
    color: #030712;
    border-color: #ffffff;
  }
</style>

<script>
  const filterContainer = document.querySelector("[data-quest-filters]");
  if (filterContainer) {
    let activeStatus = "all";
    let activeCat = "all";

    const statusBtns = filterContainer.querySelectorAll<HTMLButtonElement>("[data-filter-status]");
    const catBtns = filterContainer.querySelectorAll<HTMLButtonElement>("[data-filter-cat]");
    const cards = document.querySelectorAll<HTMLElement>("[data-quest-card]");

    const updateCards = () => {
      for (const card of cards) {
        const st = card.dataset.status || "";
        const cat = card.dataset.cat || "";
        const matchStatus = activeStatus === "all" || st === activeStatus;
        const matchCat = activeCat === "all" || cat === activeCat;
        card.style.display = matchStatus && matchCat ? "" : "none";
      }
    };

    statusBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeStatus = btn.dataset.filterStatus || "all";
        statusBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
        updateCards();
      });
    });

    catBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCat = btn.dataset.filterCat || "all";
        catBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
        updateCards();
      });
    });
  }
</script>
