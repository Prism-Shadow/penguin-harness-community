---
import type { Locale } from "../shared/i18n";
import {
  QUESTS,
  QUEST_DOMAINS,
  buildClaimIssueUrl,
  buildProposeTaskPrUrl,
  type QuestDomain,
  type QuestItem,
} from "../shared/community";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const COPY = {
  zh: {
    title: "任务板",
    propose: "发布任务 ↗",
    colDomain: "领域",
    colOpen: "待认领",
    colInProgress: "进行中",
    colCompleted: "已完成",
    unclaimed: "认领 ↗",
    empty: "—",
  },
  en: {
    title: "Quests",
    propose: "Propose Task ↗",
    colDomain: "Domain",
    colOpen: "Open",
    colInProgress: "In Progress",
    colCompleted: "Completed",
    unclaimed: "Claim ↗",
    empty: "—",
  },
}[locale];

type StageKey = "open" | "in_progress" | "completed";

const STAGES: { key: StageKey; label: string; match: (q: QuestItem) => boolean }[] = [
  { key: "open", label: COPY.colOpen, match: (q) => q.status === "open" },
  {
    key: "in_progress",
    label: COPY.colInProgress,
    match: (q) => q.status === "claimed" || q.status === "in_review",
  },
  { key: "completed", label: COPY.colCompleted, match: (q) => q.status === "completed" },
];

function tasksFor(domain: QuestDomain, match: (q: QuestItem) => boolean): QuestItem[] {
  return QUESTS.filter((q) => q.domain === domain && match(q));
}
---

<div class="mx-auto w-full max-w-6xl px-6 py-12">
  <header class=" flex items-baseline justify-between gap-4 pb-8">
    <h1 class="text-3xl font-semibold tracking-tight text-gray-950 dark:text-white">
      {COPY.title}
    </h1>
    <a
      href={buildProposeTaskPrUrl()}
      class="text-sm text-gray-500 transition-colors hover:text-gray-950 dark:text-gray-400 dark:hover:text-white"
    >
      {COPY.propose}
    </a>
  </header>

  <!-- 2D Kanban Matrix: Horizontal = Progress, Vertical = Domain -->
  <div class="overflow-x-auto border-t border-gray-200 dark:border-gray-800">
    <table class="w-full min-w-[760px] border-collapse text-left align-top">
      <thead>
        <tr class="border-b border-gray-200 text-xs font-medium text-gray-500 dark:border-gray-800 dark:text-gray-400">
          <th class="w-40 py-3 pr-4 font-medium">{COPY.colDomain}</th>
          {
            STAGES.map((stage) => (
              <th class="w-[calc((100%-10rem)/3)] px-3 py-3 font-medium">
                <span>{stage.label}</span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
        {
          QUEST_DOMAINS.map((domain) => (
            <tr>
              <th class="py-4 pr-4 align-top text-sm font-semibold text-gray-950 dark:text-gray-100">
                {domain}
              </th>
              {STAGES.map((stage) => {
                const items = tasksFor(domain, stage.match);
                return (
                  <td class="px-3 py-4 align-top">
                    {items.length === 0 ? (
                      <span class="text-xs text-gray-300 dark:text-gray-700">{COPY.empty}</span>
                    ) : (
                      <div class="space-y-2.5">
                        {items.map((q) => {
                          const targetUrl =
                            q.status === "open"
                              ? buildClaimIssueUrl(q, locale)
                              : (q.linkedPrUrl ?? `https://github.com/${q.assignee}`);
                          return (
                            <div class="rounded-lg border border-gray-200 bg-white p-3 transition-colors hover:border-gray-300 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-gray-700">
                              <a
                                href={targetUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block text-sm font-medium leading-snug text-gray-900 hover:text-brand-600 dark:text-gray-100 dark:hover:text-brand-400"
                              >
                                {q.title[locale]}
                              </a>
                              <div class="mt-2 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                                <span>{stage.label}</span>
                                {q.assignee ? (
                                  <a
                                    href={`https://github.com/${q.assignee}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="mono text-gray-700 hover:underline dark:text-gray-300"
                                  >
                                    @{q.assignee}
                                  </a>
                                ) : (
                                  <a
                                    href={buildClaimIssueUrl(q, locale)}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="font-medium text-brand-600 hover:underline dark:text-brand-400"
                                  >
                                    {COPY.unclaimed}
                                  </a>
                                )}
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
