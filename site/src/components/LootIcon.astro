---
import type { LootId } from "../shared/community";

interface Props {
  item: LootId;
  class?: string;
}

const { item, class: className = "h-6 w-6" } = Astro.props;
---

{
  item === "evolution-core" && (
    <svg viewBox="0 0 48 48" class={className} fill="none" aria-hidden="true">
      <defs>
        <radialGradient id="evo-core-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#f5f3ff" />
          <stop offset="45%" stop-color="#a78bfa" />
          <stop offset="100%" stop-color="#6d28d9" stop-opacity="0.15" />
        </radialGradient>
        <linearGradient id="evo-core-ring" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#c4b5fd" />
          <stop offset="100%" stop-color="#7c3aed" />
        </linearGradient>
      </defs>
      <circle cx="24" cy="24" r="20" fill="url(#evo-core-glow)" />
      <ellipse cx="24" cy="24" rx="18" ry="8" transform="rotate(-30 24 24)" stroke="url(#evo-core-ring)" stroke-width="2" stroke-dasharray="4 2" />
      <ellipse cx="24" cy="24" rx="18" ry="8" transform="rotate(30 24 24)" stroke="url(#evo-core-ring)" stroke-width="2" />
      <polygon points="24,8 34,18 30,34 18,34 14,18" fill="#7c3aed" fill-opacity="0.35" stroke="#ddd6fe" stroke-width="1.6" />
      <polygon points="24,13 31,24 24,35 17,24" fill="#c4b5fd" stroke="#ffffff" stroke-width="1.4" />
      <circle cx="24" cy="24" r="3.5" fill="#ffffff" />
      <circle cx="11" cy="14" r="2" fill="#ddd6fe" />
      <circle cx="37" cy="34" r="2" fill="#a78bfa" />
    </svg>
  )
}

{
  item === "trace-crystal" && (
    <svg viewBox="0 0 48 48" class={className} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="crystal-body" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#93c5fd" />
          <stop offset="50%" stop-color="#3b82f6" />
          <stop offset="100%" stop-color="#1d4ed8" />
        </linearGradient>
        <linearGradient id="crystal-facet" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#eff6ff" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.2" />
        </linearGradient>
      </defs>
      <polygon points="24,4 38,16 33,40 15,40 10,16" fill="url(#crystal-body)" stroke="#bfdbfe" stroke-width="1.8" stroke-linejoin="round" />
      <polygon points="24,4 38,16 24,22 10,16" fill="url(#crystal-facet)" />
      <polyline points="24,4 24,42" stroke="#dbeafe" stroke-width="1.5" />
      <polyline points="10,16 24,22 38,16" stroke="#dbeafe" stroke-width="1.4" />
      <polyline points="15,40 24,22 33,40" stroke="#93c5fd" stroke-width="1.2" />
      <circle cx="16" cy="11" r="1.6" fill="#ffffff" />
      <circle cx="37" cy="10" r="1.4" fill="#93c5fd" />
    </svg>
  )
}

{
  item === "harness-gear" && (
    <svg viewBox="0 0 48 48" class={className} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="gear-gold" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fde68a" />
          <stop offset="55%" stop-color="#f59e0b" />
          <stop offset="100%" stop-color="#b45309" />
        </linearGradient>
      </defs>
      <path
        d="M21 5h6l1.2 4.4a14 14 0 0 1 4.1 1.7l4-2.2 4.2 4.2-2.2 4a14 14 0 0 1 1.7 4.1L44 22.4v5.2l-4 1.2a14 14 0 0 1-1.7 4.1l2.2 4-4.2 4.2-4-2.2a14 14 0 0 1-4.1 1.7L27 45h-6l-1.2-4.4a14 14 0 0 1-4.1-1.7l-4 2.2-4.2-4.2 2.2-4a14 14 0 0 1-1.7-4.1L4 27.6v-5.2l4-1.2a14 14 0 0 1 1.7-4.1l-2.2-4 4.2-4.2 4 2.2a14 14 0 0 1 4.1-1.7L21 5Z"
        fill="url(#gear-gold)"
        stroke="#fef3c7"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <circle cx="24" cy="25" r="9" fill="#1e293b" stroke="#fcd34d" stroke-width="2" />
      <polygon points="24,19 29,25 24,31 19,25" fill="#38bdf8" stroke="#e0f2fe" stroke-width="1.2" />
    </svg>
  )
}

{
  item === "ontology-rune" && (
    <svg viewBox="0 0 48 48" class={className} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="rune-emerald" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#6ee7b7" />
          <stop offset="50%" stop-color="#10b981" />
          <stop offset="100%" stop-color="#065f46" />
        </linearGradient>
      </defs>
      <polygon points="24,4 41,14 41,34 24,44 7,34 7,14" fill="url(#rune-emerald)" stroke="#a7f3d0" stroke-width="1.8" stroke-linejoin="round" />
      <polygon points="24,9 36,16 36,32 24,39 12,32 12,16" fill="#064e3b" fill-opacity="0.55" stroke="#6ee7b7" stroke-width="1.2" />
      <line x1="24" y1="14" x2="16" y2="28" stroke="#ecfdf5" stroke-width="1.8" />
      <line x1="24" y1="14" x2="32" y2="28" stroke="#ecfdf5" stroke-width="1.8" />
      <line x1="16" y1="28" x2="32" y2="28" stroke="#ecfdf5" stroke-width="1.8" />
      <circle cx="24" cy="14" r="3" fill="#ffffff" stroke="#10b981" stroke-width="1.4" />
      <circle cx="16" cy="28" r="3" fill="#a7f3d0" stroke="#065f46" stroke-width="1.4" />
      <circle cx="32" cy="28" r="3" fill="#a7f3d0" stroke="#065f46" stroke-width="1.4" />
    </svg>
  )
}

{
  item === "benchmark-astrolabe" && (
    <svg viewBox="0 0 48 48" class={className} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="astro-rose" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#f9a8d4" />
          <stop offset="50%" stop-color="#ec4899" />
          <stop offset="100%" stop-color="#9d174d" />
        </linearGradient>
      </defs>
      <circle cx="24" cy="24" r="19" stroke="url(#astro-rose)" stroke-width="2.4" fill="#831843" fill-opacity="0.2" />
      <circle cx="24" cy="24" r="13" stroke="#fbcfe8" stroke-width="1.4" stroke-dasharray="3 3" />
      <path d="M24 5 L27 21 L43 24 L27 27 L24 43 L21 27 L5 24 L21 21 Z" fill="url(#astro-rose)" stroke="#fdf2f8" stroke-width="1.3" stroke-linejoin="round" />
      <circle cx="24" cy="24" r="3.5" fill="#ffffff" />
    </svg>
  )
}
