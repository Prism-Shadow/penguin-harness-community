---
import "../styles/achievement-atlas.css";
import type { Locale } from "../shared/i18n";
import { QUESTS } from "../shared/community";
import { ATLAS_STATES, researchAtlas } from "../shared/achievements";
import Logo from "./Logo.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (zh: string, en: string) => (locale === "zh" ? zh : en);
const atlas = researchAtlas(QUESTS, locale);
const { counts, total, statuses } = atlas;
const words = {
  all: t("全部", "All"),
  results: t("项任务", "quests"),
  contributor: t("贡献者", "Contributor"),
  lit: t("已点亮", "Lit"),
};
const icons: Record<string, string> = {
  benchmark: "m3 7 9-5 9 5-9 5z M3 12l9 5 9-5 M3 17l9 5 9-5",
  evaluation: "M3 18h18 M5 14l4-5 4 3 6-7",
  "rsi-algorithm": "M5 8a8 8 0 0 1 14-2l2 3m0-5v5h-5 M19 16a8 8 0 0 1-14 2l-2-3m0 5v-5h5",
  "penguin-harness": "m7 7-5 5 5 5m10-10 5 5-5 5M14 4l-4 16",
  "awesome-rsi": "M3 4c4-1 7 0 9 2 2-2 5-3 9-2v15c-4-1-7-1-9 1-2-2-5-2-9-1zM12 6v14",
};
const STAR = "M8 1.6l1.95 3.95 4.35.63-3.15 3.07.74 4.33L8 11.53l-3.89 2.05.74-4.33L1.7 6.18l4.35-.63z";
// Hub ring: completed arc first, then in-progress, on a neutral track.
const R = 35, C = 2 * Math.PI * R;
const doneArc = total ? (C * counts.completed) / total : 0;
const moveArc = total ? (C * counts.in_progress) / total : 0;
const emptyNote = { completed: t("首个成果待点亮", "First result yet to light"), in_progress: t("暂无进行中", "Nothing in progress"), open: t("暂无待认领", "Nothing open") };
---
<details class="atlas" id="atlas" open data-atlas data-model={JSON.stringify({ quests: atlas.quests, statuses, words })}>
  <summary class="atlas-head">
    <span class="head-copy">
      <small class="kicker" lang="en"><i></i>COMMUNITY ATLAS</small>
      <strong>{t("社区成就树", "Community achievement tree")}</strong>
      <span class="lede">{t("从左往右读：社区 → 方向 → 状态 → 任务。金色徽章是社区已经点亮的成果。", "Read left to right: community → domain → status → quest. Gold badges mark what the community has already achieved.")}</span>
    </span>
    <span class="disclosure"><span class="opened">{t("收起", "Collapse")}</span><span class="closed">{t("展开", "Expand")}</span><i></i></span>
  </summary>

  <div class="toolbar">
    <div class="filters" role="group" aria-label={t("按任务状态筛选", "Filter quests by status")}>
      <button type="button" data-filter="all" aria-pressed="true">{words.all}<b>{total}</b></button>
      {ATLAS_STATES.map((s) => (
        <button type="button" data-filter={s} data-state={s} aria-pressed="false">
          <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">{s === "completed" ? <path d={STAR} /> : <circle cx="8" cy="8" r="5.25" />}{s === "in_progress" && <path class="half" d="M8 2.75a5.25 5.25 0 0 1 0 10.5z" />}</svg>
          {statuses[s]}<b>{counts[s]}</b>
        </button>
      ))}
    </div>
    <div class="tools">
      <span class="pan-controls" data-pan-tools hidden>
        <button type="button" data-pan-left aria-label={t("画布向左滚动", "Scroll canvas left")}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg></button>
        <span>{t("横向浏览", "Pan")}</span>
        <button type="button" data-pan-right aria-label={t("画布向右滚动", "Scroll canvas right")}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg></button>
      </span>
      <a class="skip" href="#quest-list">{t("跳到任务列表", "Skip to quest list")}</a>
    </div>
  </div>

  <div class="stage" data-stage>
    <div class="viewport" data-scroll tabindex="0" role="region" aria-label={t("社区成就树，从左往右浏览", "Community achievement tree, read from left to right")}>
      <div class="canvas" data-canvas>
        <svg class="wires" data-wires aria-hidden="true"></svg>

        <div class="hub" data-hub>
          <span class="medal">
            <svg class="progress" viewBox="0 0 80 80" aria-hidden="true">
              <circle class="track" cx="40" cy="40" r={R} />
              <circle class="arc arc-move" cx="40" cy="40" r={R} stroke-dasharray={`${moveArc} ${C}`} stroke-dashoffset={-doneArc} />
              <circle class="arc arc-done" cx="40" cy="40" r={R} stroke-dasharray={`${doneArc} ${C}`} />
            </svg>
            <Logo class="brand-mark" />
          </span>
          <b>{t("RSI 社区", "RSI community")}</b>
          <small><strong>{counts.completed}</strong> / {total}<span> {words.lit}</span></small>
        </div>

        <div class="branches">
          {atlas.domains.map((d) => (
            <section class="branch" data-domain={d.id} aria-labelledby={`atlas-heading-${d.id}`}>
              <div class="domain" data-domain-node>
                <span class="domain-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[d.id]} /></svg></span>
                <h2 id={`atlas-heading-${d.id}`}>{d.title}</h2>
                <span class="domain-stat"><b>{d.counts.completed}</b> / {d.total} {words.lit}</span>
                <span class="meter" aria-hidden="true">
                  {ATLAS_STATES.map((s) => d.counts[s] > 0 && <i data-state={s} style={`flex-grow:${d.counts[s]}`}></i>)}
                </span>
              </div>
              <div class="lanes">
                {ATLAS_STATES.map((state) => {
                  const items = d.lanes[state];
                  const labelId = `atlas-${d.id}-${state}`;
                  return (
                    <section class="lane" data-lane={state} data-count={items.length} aria-labelledby={labelId}>
                      <div class="lane-key">
                      <h3 class="lane-head" id={labelId} data-lane-head>
                        <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">{state === "completed" ? <path d={STAR} /> : <circle cx="8" cy="8" r="5.25" />}{state === "in_progress" && <path class="half" d="M8 2.75a5.25 5.25 0 0 1 0 10.5z" />}</svg>
                        <span class="lane-name">{statuses[state]}</span><b>{items.length}</b>
                      </h3>
                      </div>
                      {items.length > 0 ? (
                        <ul class="leaves" data-leaves>
                          {items.map((q) => (
                            <li>
                              <a class="leaf" data-record={q.id} data-state={state} href={q.links[0].url} title={q.title}>
                                <span class="badge" aria-hidden="true">
                                  {state === "completed" && <svg viewBox="0 0 16 16"><path d={STAR} /></svg>}
                                  {state === "in_progress" && <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="5" /><path d="M8 3a5 5 0 0 1 0 10z" /></svg>}
                                  {state === "open" && <svg viewBox="0 0 16 16"><path d="M8 4.5v7M4.5 8h7" /></svg>}
                                </span>
                                <span class="leaf-title"><small>#{q.number}</small>{q.title}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <span class="vacant" data-leaves>{emptyNote[state]}</span>
                      )}
                    </section>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>

  <dialog class="dossier" data-detail aria-labelledby="atlas-detail-title">
    <div class="dossier-inner">
      <p class="dossier-kicker"><span class="pill" data-status></span><span data-domain-label></span></p>
      <h3 id="atlas-detail-title" data-title></h3>
      <button class="close" type="button" data-close autofocus aria-label={t("关闭详情", "Close details")}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" /></svg></button>
      <p class="dossier-summary" data-summary></p>
      <div class="facts" data-facts></div>
      <div class="relations" data-neighbors></div>
    </div>
  </dialog>
  <span class="sr-only" aria-live="polite" data-live></span>
</details>
<script>
  import { initAtlas } from "../shared/achievement-atlas-ui";
  document.querySelectorAll<HTMLDetailsElement>("[data-atlas]").forEach(initAtlas);
</script>
