---
import "../styles/achievement-atlas.css";
import type { Locale } from "../shared/i18n";
import { QUESTS } from "../shared/community";
import { ATLAS_STATES, researchAtlas } from "../shared/achievements";
import Logo from "./Logo.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = (zh: string, en: string) => (locale === "zh" ? zh : en);
const atlas = researchAtlas(QUESTS, locale);
const { counts, total, statuses } = atlas;
const words = {
  all: t("全部", "All"),
  results: t("枚勋章", "medals"),
  lit: t("已点亮", "lit"),
  evidence: t("点亮证据", "Evidence"),
  quests: t("点亮任务", "Quests behind it"),
  needs: t("需要先点亮", "Needs lighting first"),
  unlocks: t("点亮后解锁", "Lights the way to"),
  contributor: t("贡献者", "Contributor"),
  unregistered: t("项任务尚未登记", "quests not on the board yet"),
};
// One icon per long-term route.
const icons: Record<string, string> = {
  infra: "m3 7 9-5 9 5-9 5z M3 12l9 5 9-5 M3 17l9 5 9-5",
  agent: "M12 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4M5.5 16a2 2 0 1 1 0 4 2 2 0 0 1 0-4M18.5 16a2 2 0 1 1 0 4 2 2 0 0 1 0-4M10.7 6.9 7 14M13.3 6.9 17 14M7.5 18h9",
  method: "M5 8a8 8 0 0 1 14-2l2 3m0-5v5h-5 M19 16a8 8 0 0 1-14 2l-2-3m0 5v-5h5",
  standard: "m7 7-5 5 5 5m10-10 5 5-5 5M14 4l-4 16",
  product: "M3 18h18 M5 14l4-5 4 3 6-7",
};
const STAR = "M8 1.6l1.95 3.95 4.35.63-3.15 3.07.74 4.33L8 11.53l-3.89 2.05.74-4.33L1.7 6.18l4.35-.63z";
const LOCK = "M5.6 7.4V5.9a2.4 2.4 0 0 1 4.8 0v1.5M4.6 7.4h6.8v5.2H4.6z";
// Hub ring: the lit arc first, then what is ready to push, on a neutral track.
const R = 35, C = 2 * Math.PI * R;
const litArc = total ? (C * counts.lit) / total : 0;
const readyArc = total ? (C * counts.ready) / total : 0;
// Desktop zoom of the tree only (titles, filters and toolbar keep their size). Phones always use 100%.
const ZOOM = { initial: 0.8, min: 0.5, max: 1.25 };
---
<details class="atlas" id="atlas" open data-atlas style={`--zoom: ${ZOOM.initial}`} data-model={JSON.stringify({ medals: atlas.medals, statuses, words, zoom: ZOOM })}>
  <summary class="atlas-head border-b border-gray-200 pb-2.5 dark:border-gray-800">
    <h2 class="flex items-center justify-between gap-4 text-xl font-semibold tracking-tight text-gray-950 dark:text-white">
      <span>{t("社区成就树", "Community achievement tree")}</span>
      <span class="disclosure"><span class="opened">{t("收起", "Collapse")}</span><span class="closed">{t("展开", "Expand")}</span><i aria-hidden="true"></i></span>
    </h2>
  </summary>

  <div class="atlas-frame mt-4">
    <div class="toolbar">
      <div class="filters" role="group" aria-label={t("按勋章状态筛选", "Filter medals by state")}>
        <button type="button" data-filter="all" aria-pressed="true">{words.all}<b>{total}</b></button>
        {ATLAS_STATES.map((s) => (
          <button type="button" data-filter={s} data-state={s} aria-pressed="false">
            <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">{s === "lit" ? <path d={STAR} /> : s === "locked" ? <path d={LOCK} /> : <><circle cx="8" cy="8" r="5.25" /><path class="half" d="M8 2.75a5.25 5.25 0 0 1 0 10.5z" /></>}</svg>
            {statuses[s]}<b>{counts[s]}</b>
          </button>
        ))}
      </div>
      <div class="tools">
        <span class="pan-controls" data-pan-tools hidden>
          <button type="button" data-pan-left aria-label={t("画布向左滚动", "Scroll canvas left")}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg></button>
          <span>{t("横向浏览", "Pan")}</span>
          <button type="button" data-pan-right aria-label={t("画布向右滚动", "Scroll canvas right")}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg></button>
        </span>
        <a class="skip" href="#quest-list">{t("跳到任务列表", "Skip to quest list")}</a>
      </div>
    </div>

    <div class="stage" data-stage>
      <div class="viewport" data-scroll tabindex="0" role="region" aria-keyshortcuts="+ - 0" aria-label={t("社区成就树，从左往右浏览", "Community achievement tree, read from left to right")}>
        <div class="canvas" data-canvas>
          <svg class="wires" data-wires aria-hidden="true"></svg>

          <div class="hub" data-hub style={`grid-row: 1 / span ${atlas.routes.length}`}>
            <span class="medal">
              <svg class="progress" viewBox="0 0 80 80" aria-hidden="true">
                <circle class="track" cx="40" cy="40" r={R} />
                <circle class="arc arc-move" cx="40" cy="40" r={R} stroke-dasharray={`${readyArc} ${C}`} stroke-dashoffset={-litArc} />
                <circle class="arc arc-done" cx="40" cy="40" r={R} stroke-dasharray={`${litArc} ${C}`} />
              </svg>
              <Logo class="brand-mark" />
            </span>
            <b>{t("RSI 社区", "RSI community")}</b>
            <small><strong>{counts.lit}</strong> / {total}<span> {words.lit}</span></small>
          </div>

          <div class="branches">
            {atlas.routes.map((route) => (
              <section class="branch" data-domain={route.id} aria-labelledby={`atlas-heading-${route.id}`}>
                <div class="domain" data-domain-node>
                  <span class="domain-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[route.id]} /></svg></span>
                  <h3 id={`atlas-heading-${route.id}`} title={route.aim}>{route.title}</h3>
                  <span class="domain-stat"><b class:list={{ lit: route.counts.lit > 0 }}>{route.counts.lit}</b> / {route.total} {words.lit}</span>
                  <span class="meter" aria-hidden="true">
                    {ATLAS_STATES.map((s) => route.counts[s] > 0 && <i data-state={s} style={`flex-grow:${route.counts[s]}`}></i>)}
                  </span>
                </div>
                <div class="lanes">
                  {route.branches.map((branch) => {
                    const labelId = `atlas-${route.id}-${branch.id}`;
                    return (
                      <section class="lane" data-lane={branch.id} data-count={branch.total} data-lit={branch.lit > 0 ? "" : null} data-complete={branch.lit === branch.total ? "" : null} aria-labelledby={labelId}>
                        <div class="lane-key">
                          <h4 class="lane-head" id={labelId} data-lane-head>
                            <span class="lane-name">{branch.title}</span><b>{branch.lit}/{branch.total}</b>
                          </h4>
                        </div>
                        <ul class="leaves" data-leaves>
                          {branch.medals.map((m) => (
                            <li>
                              <a class="leaf" data-record={m.id} data-state={m.state} href={m.href} title={m.intent}>
                                <span class="badge" aria-hidden="true">
                                  {m.state === "lit" && <svg viewBox="0 0 16 16"><path d={STAR} /></svg>}
                                  {m.state === "ready" && <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="5" /><path d="M8 3a5 5 0 0 1 0 10z" /></svg>}
                                  {m.state === "locked" && <svg viewBox="0 0 16 16"><path d={LOCK} /></svg>}
                                </span>
                                <span class="leaf-title"><small>{m.tag}</small>{m.name}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </section>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <dialog class="dossier" data-detail aria-labelledby="atlas-detail-title">
    <div class="dossier-inner">
      <p class="dossier-kicker"><span class="pill" data-status></span><span data-domain-label></span></p>
      <h3 id="atlas-detail-title" data-title></h3>
      <button class="close" type="button" data-close autofocus aria-label={t("关闭详情", "Close details")}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" /></svg></button>
      <p class="dossier-summary" data-summary></p>
      <p class="dossier-evidence"><b>{words.evidence}</b><span data-evidence></span></p>
      <p class="dossier-note" data-note hidden></p>
      <div data-facts></div>
      <div data-neighbors></div>
    </div>
  </dialog>
  <span class="sr-only" aria-live="polite" data-live></span>
</details>
<script>
  import { initAtlas } from "../shared/achievement-atlas-ui";
  document.querySelectorAll<HTMLDetailsElement>("[data-atlas]").forEach(initAtlas);
</script>
