---
import { localePath, type Locale } from "../shared/i18n";
import {
  FORUM_THREADS,
  buildNewThreadIssueUrl,
} from "../shared/community";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const href = (path: string) => localePath(locale, path);
const otherLocale: Locale = locale === "zh" ? "en" : "zh";
const switchHref = localePath(otherLocale, "/forum/");

const COPY = {
  zh: {
    title: "讨论",
    langSwitch: "English",
    subtitle: "论文精读、实验手记与社区进展。",
    newThread: "发起讨论 ↗",
    by: "By ",
  },
  en: {
    title: "Discussions",
    langSwitch: "中文",
    subtitle: "Paper notes, empirical findings, and community updates.",
    newThread: "New Thread ↗",
    by: "By ",
  },
}[locale];
---

<div class="mx-auto w-full max-w-3xl px-6 py-12">
  <header class="pb-10">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="text-4xl font-semibold tracking-tight text-gray-950 dark:text-white">
        {COPY.title}
      </h1>
      <div class="flex items-center gap-4 text-sm">
        <a
          href={buildNewThreadIssueUrl(locale)}
          class="text-gray-500 transition-colors hover:text-gray-950 dark:text-gray-400 dark:hover:text-white"
        >
          {COPY.newThread}
        </a>
        <a
          href={switchHref}
          data-lang-switch={otherLocale}
          class="text-gray-500 transition-colors hover:text-gray-950 dark:text-gray-400 dark:hover:text-white"
        >
          {COPY.langSwitch}
        </a>
      </div>
    </div>
    <p class="mt-4 max-w-[62ch] text-sm leading-relaxed text-gray-500 dark:text-gray-400">
      {COPY.subtitle}
    </p>
  </header>

  <div class="border-t border-gray-200 dark:border-gray-800">
    {
      FORUM_THREADS.map((thread) => {
        const primaryUrl = thread.links?.[0]?.url ?? href(`/quests/#${thread.linkedQuestId.toLowerCase()}`);
        return (
          <div class="border-b border-gray-200 py-6 dark:border-gray-800">
            <div class="flex items-baseline justify-between gap-4 text-xs text-gray-400 dark:text-gray-500">
              <span class="mono">#{thread.board}</span>
              <span class="mono">{thread.createdAt}</span>
            </div>

            <a href={primaryUrl} class="group block">
              <h2 class="mt-2 text-lg font-medium text-gray-950 transition-colors group-hover:text-brand-600 dark:text-gray-100 dark:group-hover:text-brand-400">
                {thread.title[locale]}
              </h2>
              <p class="mt-1.5 max-w-[62ch] text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                {thread.summary[locale]}
              </p>
            </a>

            <p class="mt-2 text-xs text-gray-400 dark:text-gray-500">
              {COPY.by}
              <a
                href={`https://github.com/${thread.handle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 hover:underline dark:text-gray-300"
              >
                {thread.author}
              </a>
            </p>
          </div>
        );
      })
    }
  </div>
</div>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]")) {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem("phc-site.lang", link.dataset.langSwitch!);
      } catch {}
    });
  }
</script>
