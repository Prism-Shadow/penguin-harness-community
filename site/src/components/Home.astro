---
import Logo from "./Logo.astro";
import { localePath, type Locale } from "../shared/i18n";
import { DISCORD_URL } from "../shared/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const href = (path: string) => localePath(locale, path);

const COPY = {
  zh: {
    ctaRoadmap: "路线图",
    ctaQuests: "任务板",
    ctaProcess: "流程",
    ctaRfcs: "标准文件",
    ctaPeople: "成员",
    wechat: "微信群",
    discord: "Discord",
    heroLead:
      "在 Agent 时代，研究的速度每日都在加快，AutoResearch 与递归自进化（RSI）正从构想走向现实。我们构建了这个开源共建的 RSI 社区与平台，只为让你真正“摸到” RSI 的边界——用自进化的方法完成前沿探索，推动跨领域的 AI 应用落地。",
    visionEyebrow: "COMMUNITY VISION · 社区愿景与构想",
    visionTitle: "筑牢自进化基建，共建 Agent-Native 与 RSI-Native 的国际开源社区",
    pillar1Tag: "01 · INFRASTRUCTURE & TOOLCHAIN",
    pillar1Title: "做好基建与工具链，连接跨机构合作探索",
    pillar1Desc:
      "围绕统一评测基准（GDPevo）、自进化外骨骼框架（PenguinHarness）与文献谱系（Awesome RSI）打磨开源工具链，降低算力与实验门槛，让参与的同学能够开展贴近 RSI 核心边界的研究，鼓励不同高校、实验室与机构之间深度合作，实现跨领域的 AI 应用落地。",
    pillar2Tag: "02 · AGENT-NATIVE & RSI-NATIVE HUB",
    pillar2Title: "打造面向 Agent 与 RSI 时代的“Hugging Face”",
    pillar2Desc:
      "我们希望打造出像 Hugging Face 一样开放繁荣、但更加 Agent-native 和 RSI-native 的开源社区——让评测基准、可验证进化轨迹（Traces）、自进化算法与技能插件自由流转与复现。为此我们成立了社区委员会，大家一起出谋划策，做出一个国际知名的开源社区。",
    committeeEyebrow: "GOVERNANCE & EXECUTION · 社区委员会两大核心事务",
    committeeTitle: "课题驱动质量对齐，开放机制链接全球同仁",
    duty1Tag: "MISSION A · 课题与质量",
    duty1Title: "发布和审核研究课题，对齐社区研发进度",
    duty1Desc:
      "由委员会成员共同策展前沿研究课题、严格评审提交成果的可复现性，保障社区内容的整体学术与工程质量。我们已经搭建好一套全自动同步的任务看板，实时对齐五大方向的认领与推进进度。",
    duty1LinkLabel: "前往任务板 (/quests/) →",
    duty2Tag: "MISSION B · 机制与生态",
    duty2Title: "探讨 RSI 社区运作机制，链接外部资源与同仁",
    duty2Desc:
      "持续打磨开放透明的社区协作与激励机制（经验值 1:1 兑换 Token 额度、算力支持与原创论文共创署名），积极链接高校、实验室与产业外部资源，邀请更多志同道合的同仁加入，把社区做得越来越热闹。",
    duty2LinkLabel: "查看委员会与激励机制 (/people/) →",
    closingQuote:
      "虽然社区还很早期，但是我们对 RSI 探索非常执着，很期待能和大家一起做大事。",
    closingCtaQuests: "认领研究课题",
    closingCtaWechat: "加入微信交流群",
  },
  en: {
    ctaRoadmap: "Roadmap",
    ctaQuests: "Quests",
    ctaProcess: "Workflow",
    ctaRfcs: "RFCs",
    ctaPeople: "People",
    wechat: "WeChat",
    discord: "Discord",
    heroLead:
      "In the Agent era, research velocity is accelerating every day — AutoResearch and Recursive Self-Improvement (RSI) are moving from vision to reality. We built this open-source RSI community and platform so researchers and builders can truly touch the boundary of RSI and turn self-evolving methods into cross-domain AI applications.",
    visionEyebrow: "COMMUNITY VISION · WHY WE BUILT THIS",
    visionTitle: "Building the Infrastructure and the Agent-Native, RSI-Native Open Community",
    pillar1Tag: "01 · INFRASTRUCTURE & TOOLCHAIN",
    pillar1Title: "Solid Infrastructure & Toolchain for Cross-Institutional Research",
    pillar1Desc:
      "By building unified benchmarks (GDPevo), a self-evolving harness framework (PenguinHarness), and a living research taxonomy (Awesome RSI), we lower the barrier to hands-on RSI exploration and foster collaboration across universities, labs, and institutions toward real-world, cross-domain AI impact.",
    pillar2Tag: "02 · AGENT-NATIVE & RSI-NATIVE HUB",
    pillar2Title: "The Hugging Face for the Agent & RSI Era",
    pillar2Desc:
      "We aim to build an open-source community like Hugging Face — but natively designed for Agents and RSI — where benchmarks, verifiable evolution traces, algorithms, and skill plugins are openly shared. Together with our Community Committee, we are co-building an internationally recognized open-source hub.",
    committeeEyebrow: "GOVERNANCE & EXECUTION · COMMUNITY COMMITTEE",
    committeeTitle: "Curating Frontier Research Quests & Connecting Global Collaborators",
    duty1Tag: "MISSION A · QUESTS & QUALITY",
    duty1Title: "Publish & Review Research Topics with Live Progress Alignment",
    duty1Desc:
      "The Community Committee curates high-impact research topics and reviews submissions for rigor and reproducibility to uphold overall quality. We have built a live Task Board to transparently align progress across all five contribution tracks.",
    duty1LinkLabel: "Explore the Task Board (/quests/) →",
    duty2Tag: "MISSION B · GOVERNANCE & ECOSYSTEM",
    duty2Title: "Shape RSI Community Mechanisms & Connect External Resources",
    duty2Desc:
      "We continuously refine open governance and contributor incentives (1:1 EXP-to-Token/compute rewards and paper co-authorship), connect external compute and academic/industry partners, and invite passionate peers worldwide to make the community thrive.",
    duty2LinkLabel: "Meet the Committee & Rewards (/people/) →",
    closingQuote:
      "We are still in our early days, yet our conviction in exploring RSI is unwavering — we look forward to building something extraordinary together with you.",
    closingCtaQuests: "Explore Open Quests",
    closingCtaWechat: "Join Community WeChat",
  },
}[locale];
---

<section class="lg:flex lg:flex-1 lg:items-center" data-hero>
  <div class="relative mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:py-8">
    <div>
      <div class="rise flex items-center gap-3">
        <Logo class="h-10 w-10 shrink-0" />
      </div>

      <h1
        class="rise mt-6 text-4xl leading-[1.15] font-semibold tracking-tight sm:text-5xl"
        style="animation-delay: 50ms"
      >
        Shared <span class="text-brand-600 dark:text-brand-400">RSI</span> Community
      </h1>

      <p
        class="rise mono mt-4 text-base text-gray-600 sm:text-lg dark:text-gray-400"
        style="animation-delay: 100ms"
      >
        RSI Benchmark × Evaluation × Algorithm
      </p>

      <p
        class="rise mt-4 max-w-xl text-[15px] leading-relaxed text-gray-600 dark:text-gray-300"
        style="animation-delay: 125ms"
      >
        {COPY.heroLead}
      </p>

      <div class="rise mt-7 flex flex-wrap gap-3" style="animation-delay: 150ms">
        <a
          href={href("/roadmap/")}
          class="inline-flex h-11 items-center gap-2 rounded-lg bg-black px-5 text-[15px] font-medium text-white transition-colors hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-200"
        >
          {COPY.ctaRoadmap}
        </a>
        <a
          href={href("/workflow/")}
          class="inline-flex h-11 items-center gap-2 rounded-lg border border-gray-200 bg-white px-5 text-[15px] font-medium text-gray-900 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:hover:bg-gray-900"
        >
          {COPY.ctaProcess}
        </a>
        <a
          href={href("/rfcs/")}
          class="inline-flex h-11 items-center gap-2 rounded-lg border border-gray-200 bg-white px-5 text-[15px] font-medium text-gray-900 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:hover:bg-gray-900"
        >
          {COPY.ctaRfcs}
        </a>
        <a
          href={href("/quests/")}
          class="inline-flex h-11 items-center gap-2 rounded-lg border border-gray-200 bg-white px-5 text-[15px] font-medium text-gray-900 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:hover:bg-gray-900"
        >
          {COPY.ctaQuests}
        </a>
        <a
          href={href("/people/")}
          class="inline-flex h-11 items-center gap-2 rounded-lg border border-gray-200 bg-white px-5 text-[15px] font-medium text-gray-900 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:hover:bg-gray-900"
        >
          {COPY.ctaPeople}
        </a>
      </div>

      <div class="rise mt-3 flex flex-wrap items-center gap-3" style="animation-delay: 190ms">
        <button
          type="button"
          data-wechat-trigger
          class="inline-flex h-10 items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 text-sm font-medium text-gray-800 transition-colors hover:bg-gray-50 hover:text-gray-950 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-200 dark:hover:bg-gray-900 dark:hover:text-white"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-[#07C160]" fill="currentColor" aria-hidden="true">
            <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088V8.89c-.135-.01-.27-.027-.407-.03zm-2.53 3.274c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.969-.982z" />
          </svg>
          <span>{COPY.wechat}</span>
        </button>
        <a
          href={DISCORD_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-direct-external
          class="inline-flex h-10 items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 text-sm font-medium text-gray-800 transition-colors hover:bg-gray-50 hover:text-gray-950 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-200 dark:hover:bg-gray-900 dark:hover:text-white"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-[#5865F2]" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
          </svg>
          <span>{COPY.discord}</span>
        </a>
      </div>
    </div>

    <!-- Right: Neural Network Self-Evolution Animation -->
    <div class="rise min-w-0" style="animation-delay: 120ms">
      <div
        class="relative overflow-hidden rounded-2xl border border-gray-200 bg-white/90 p-4 shadow-xs sm:p-6 dark:border-gray-800 dark:bg-gray-950/90"
        data-rsi-net
      >
        <div class="mb-3 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
          <div class="flex items-center gap-2">
            <span class="inline-block h-2 w-2 rounded-full bg-brand-500 animate-pulse"></span>
            <span class="mono font-medium text-gray-700 dark:text-gray-300" data-gen-label>GEN 01</span>
            <span class="mono text-gray-400 dark:text-gray-500" data-phase-label>FORWARD</span>
          </div>
          <div class="mono flex items-center gap-2">
            <span>FITNESS</span>
            <span class="font-semibold text-brand-600 dark:text-brand-400" data-fitness-label>64.0%</span>
          </div>
        </div>

        <svg
          viewBox="0 0 560 300"
          class="block h-auto w-full select-none"
          aria-label="Neural Network Self-Evolution"
        >
          <defs>
            <linearGradient id="edge-active" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#477dfb" stop-opacity="0.35" />
              <stop offset="50%" stop-color="#477dfb" stop-opacity="0.95" />
              <stop offset="100%" stop-color="#7aa2f7" stop-opacity="0.95" />
            </linearGradient>
            <linearGradient id="feedback-grad" x1="1" y1="0" x2="0" y2="0">
              <stop offset="0%" stop-color="#7aa2f7" stop-opacity="0.9" />
              <stop offset="100%" stop-color="#477dfb" stop-opacity="0.25" />
            </linearGradient>
            <filter id="glow" x="-30%" y="-30%" width="160%" height="160%">
              <feGaussianBlur stdDeviation="3" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <!-- Subtle background grid -->
          <g class="stroke-gray-100 dark:stroke-gray-900" stroke-width="1">
            <line x1="70" y1="24" x2="70" y2="265" />
            <line x1="210" y1="24" x2="210" y2="265" />
            <line x1="350" y1="24" x2="350" y2="265" />
            <line x1="490" y1="24" x2="490" y2="265" />
          </g>

          <!-- Recursive Self-Improvement Feedback Arc (Eval -> Policy/Weights) -->
          <path
            d="M 490 95 C 430 14, 150 14, 210 62"
            fill="none"
            stroke="url(#feedback-grad)"
            stroke-width="1.75"
            stroke-dasharray="5 5"
            class="rsi-feedback-arc"
            data-feedback-arc
          />
          <path
            d="M 490 205 C 430 286, 290 286, 350 238"
            fill="none"
            stroke="url(#feedback-grad)"
            stroke-width="1.75"
            stroke-dasharray="5 5"
            class="rsi-feedback-arc"
            data-feedback-arc-2
          />

          <!-- Dynamic Edges Layer -->
          <g data-edges-layer></g>

          <!-- Signal Pulses Layer -->
          <g data-pulses-layer filter="url(#glow)"></g>

          <!-- Dynamic Nodes Layer -->
          <g data-nodes-layer></g>

          <!-- Bottom Layer Captions -->
          <g class="mono fill-gray-400 text-[10px] dark:fill-gray-500" text-anchor="middle">
            <text x="70" y="286">BENCHMARK</text>
            <text x="210" y="286">HARNESS</text>
            <text x="350" y="286">ALGORITHM</text>
            <text x="490" y="286">EVALUATION</text>
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<!-- Vision & Dual Pillars + Community Committee Section -->
<section class="border-t border-gray-200/80 bg-gradient-to-b from-gray-50/60 via-white to-white py-16 dark:border-gray-800/80 dark:from-gray-900/30 dark:via-gray-950 dark:to-gray-950">
  <div class="mx-auto w-full max-w-7xl space-y-16 px-4 sm:px-6">
    <!-- Part 1: Dual Pillars -->
    <div>
      <div class="max-w-3xl">
        <p class="mono text-xs font-semibold tracking-wider text-brand-600 uppercase dark:text-brand-400">
          {COPY.visionEyebrow}
        </p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-gray-950 sm:text-3xl dark:text-white">
          {COPY.visionTitle}
        </h2>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-gray-200/90 bg-white p-6 shadow-2xs transition-colors hover:border-brand-400/70 sm:p-7 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-brand-500/60">
          <div class="mono inline-flex items-center rounded-md bg-brand-50 px-2.5 py-1 text-[11px] font-semibold text-brand-700 ring-1 ring-inset ring-brand-600/20 dark:bg-brand-950/80 dark:text-brand-300 dark:ring-brand-400/30">
            {COPY.pillar1Tag}
          </div>
          <h3 class="mt-4 text-lg font-semibold tracking-tight text-gray-950 dark:text-white">
            {COPY.pillar1Title}
          </h3>
          <p class="mt-2.5 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {COPY.pillar1Desc}
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200/90 bg-white p-6 shadow-2xs transition-colors hover:border-brand-400/70 sm:p-7 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-brand-500/60">
          <div class="mono inline-flex items-center rounded-md bg-brand-50 px-2.5 py-1 text-[11px] font-semibold text-brand-700 ring-1 ring-inset ring-brand-600/20 dark:bg-brand-950/80 dark:text-brand-300 dark:ring-brand-400/30">
            {COPY.pillar2Tag}
          </div>
          <h3 class="mt-4 text-lg font-semibold tracking-tight text-gray-950 dark:text-white">
            {COPY.pillar2Title}
          </h3>
          <p class="mt-2.5 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
            {COPY.pillar2Desc}
          </p>
        </div>
      </div>
    </div>

    <!-- Part 2: Community Committee Two Core Duties -->
    <div>
      <div class="max-w-3xl">
        <p class="mono text-xs font-semibold tracking-wider text-brand-600 uppercase dark:text-brand-400">
          {COPY.committeeEyebrow}
        </p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-gray-950 sm:text-3xl dark:text-white">
          {COPY.committeeTitle}
        </h2>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="flex flex-col justify-between rounded-2xl border border-gray-200/90 bg-gray-50/70 p-6 sm:p-7 dark:border-gray-800 dark:bg-gray-900/40">
          <div>
            <div class="mono text-xs font-semibold text-gray-500 dark:text-gray-400">
              {COPY.duty1Tag}
            </div>
            <h3 class="mt-2 text-lg font-semibold tracking-tight text-gray-950 dark:text-white">
              {COPY.duty1Title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {COPY.duty1Desc}
            </p>
          </div>
          <div class="mt-5 pt-2">
            <a
              href={href("/quests/")}
              class="inline-flex items-center text-sm font-medium text-brand-600 hover:text-brand-500 hover:underline dark:text-brand-400"
            >
              {COPY.duty1LinkLabel}
            </a>
          </div>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border border-gray-200/90 bg-gray-50/70 p-6 sm:p-7 dark:border-gray-800 dark:bg-gray-900/40">
          <div>
            <div class="mono text-xs font-semibold text-gray-500 dark:text-gray-400">
              {COPY.duty2Tag}
            </div>
            <h3 class="mt-2 text-lg font-semibold tracking-tight text-gray-950 dark:text-white">
              {COPY.duty2Title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
              {COPY.duty2Desc}
            </p>
          </div>
          <div class="mt-5 pt-2">
            <a
              href={href("/people/")}
              class="inline-flex items-center text-sm font-medium text-brand-600 hover:text-brand-500 hover:underline dark:text-brand-400"
            >
              {COPY.duty2LinkLabel}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Part 3: Closing Manifesto Callout -->
    <div class="rounded-2xl border border-brand-200/80 bg-gradient-to-r from-brand-50/70 via-white to-brand-50/50 p-6 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-8 dark:border-brand-900/60 dark:from-brand-950/40 dark:via-gray-950 dark:to-brand-950/30">
      <p class="text-base font-medium leading-relaxed text-gray-900 sm:text-lg dark:text-gray-100">
        “{COPY.closingQuote}”
      </p>
      <div class="mt-4 flex shrink-0 flex-wrap items-center gap-3 sm:mt-0">
        <a
          href={href("/quests/")}
          class="inline-flex h-10 items-center rounded-lg bg-brand-600 px-4 text-sm font-medium text-white transition-colors hover:bg-brand-500"
        >
          {COPY.closingCtaQuests}
        </a>
        <button
          type="button"
          data-wechat-trigger
          class="inline-flex h-10 cursor-pointer items-center rounded-lg border border-gray-300 bg-white px-4 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:hover:bg-gray-800"
        >
          {COPY.closingCtaWechat}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    :global(main:has(> [data-hero])) {
      display: flex;
      flex-direction: column;
    }
  }

  .rise {
    animation: rise 0.55s cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .rsi-feedback-arc {
    opacity: 0.25;
    transition: opacity 0.4s ease, stroke-width 0.4s ease;
  }

  .rsi-feedback-arc.is-evolving {
    opacity: 0.95;
    stroke-width: 2.4;
    animation: dash-reverse 0.9s linear infinite;
  }

  @keyframes dash-reverse {
    to {
      stroke-dashoffset: -20;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
  }
</style>

<script>
  const container = document.querySelector<HTMLElement>("[data-rsi-net]");
  if (container) {
    const edgesLayer = container.querySelector<SVGGElement>("[data-edges-layer]")!;
    const pulsesLayer = container.querySelector<SVGGElement>("[data-pulses-layer]")!;
    const nodesLayer = container.querySelector<SVGGElement>("[data-nodes-layer]")!;
    const genLabel = container.querySelector<HTMLElement>("[data-gen-label]")!;
    const phaseLabel = container.querySelector<HTMLElement>("[data-phase-label]")!;
    const fitnessLabel = container.querySelector<HTMLElement>("[data-fitness-label]")!;
    const feedbackArc1 = container.querySelector<SVGPathElement>("[data-feedback-arc]")!;
    const feedbackArc2 = container.querySelector<SVGPathElement>("[data-feedback-arc-2]")!;

    const NS = "http://www.w3.org/2000/svg";

    interface NodeDef {
      id: string;
      layer: number;
      x: number;
      y: number;
      minGen?: number;
    }

    const nodes: NodeDef[] = [
      { id: "l0_0", layer: 0, x: 70, y: 78 },
      { id: "l0_1", layer: 0, x: 70, y: 150 },
      { id: "l0_2", layer: 0, x: 70, y: 222 },
      { id: "l1_0", layer: 1, x: 210, y: 62 },
      { id: "l1_1", layer: 1, x: 210, y: 120 },
      { id: "l1_2", layer: 1, x: 210, y: 180 },
      { id: "l1_3", layer: 1, x: 210, y: 238 },
      { id: "l2_0", layer: 2, x: 350, y: 62 },
      { id: "l2_1", layer: 2, x: 350, y: 120 },
      { id: "l2_2", layer: 2, x: 350, y: 180 },
      { id: "l2_3", layer: 2, x: 350, y: 238 },
      { id: "l3_0", layer: 3, x: 490, y: 95 },
      { id: "l3_1", layer: 3, x: 490, y: 205 },
    ];

    const nodeMap = new Map(nodes.map((n) => [n.id, n]));

    interface EdgeDef {
      id: string;
      from: NodeDef;
      to: NodeDef;
      weights: [number, number, number, number];
      el?: SVGLineElement;
    }

    const edgeDefs: EdgeDef[] = [];
    const pairs: [string, string, [number, number, number, number]][] = [
      ["l0_0", "l1_0", [2, 2, 3, 3]],
      ["l0_0", "l1_1", [1, 2, 2, 3]],
      ["l0_0", "l1_2", [1, 0, 0, 0]],
      ["l0_1", "l1_0", [1, 1, 2, 2]],
      ["l0_1", "l1_1", [2, 3, 3, 3]],
      ["l0_1", "l1_2", [2, 2, 3, 3]],
      ["l0_1", "l1_3", [1, 0, 0, 1]],
      ["l0_2", "l1_1", [1, 0, 0, 0]],
      ["l0_2", "l1_2", [1, 2, 2, 3]],
      ["l0_2", "l1_3", [2, 2, 3, 3]],
      ["l1_0", "l2_0", [2, 3, 3, 3]],
      ["l1_0", "l2_1", [1, 2, 3, 3]],
      ["l1_0", "l2_2", [1, 0, 0, 0]],
      ["l1_1", "l2_0", [1, 2, 2, 3]],
      ["l1_1", "l2_1", [2, 3, 3, 3]],
      ["l1_1", "l2_2", [1, 2, 3, 3]],
      ["l1_2", "l2_1", [1, 1, 2, 3]],
      ["l1_2", "l2_2", [2, 2, 3, 3]],
      ["l1_2", "l2_3", [1, 2, 2, 2]],
      ["l1_3", "l2_2", [1, 0, 1, 2]],
      ["l1_3", "l2_3", [2, 2, 3, 3]],
      ["l2_0", "l3_0", [2, 3, 3, 3]],
      ["l2_0", "l3_1", [1, 0, 0, 0]],
      ["l2_1", "l3_0", [2, 3, 3, 3]],
      ["l2_1", "l3_1", [1, 2, 2, 3]],
      ["l2_2", "l3_0", [1, 2, 2, 3]],
      ["l2_2", "l3_1", [2, 3, 3, 3]],
      ["l2_3", "l3_0", [1, 0, 0, 0]],
      ["l2_3", "l3_1", [2, 2, 3, 3]],
    ];

    for (const [u, v, w] of pairs) {
      const from = nodeMap.get(u)!;
      const to = nodeMap.get(v)!;
      const line = document.createElementNS(NS, "line");
      line.setAttribute("x1", String(from.x));
      line.setAttribute("y1", String(from.y));
      line.setAttribute("x2", String(to.x));
      line.setAttribute("y2", String(to.y));
      line.setAttribute("stroke-linecap", "round");
      line.style.transition = "stroke-width 0.45s ease, opacity 0.45s ease, stroke 0.45s ease";
      edgesLayer.appendChild(line);
      edgeDefs.push({ id: `${u}-${v}`, from, to, weights: w, el: line });
    }

    const nodeEls = new Map<string, { group: SVGGElement; halo: SVGCircleElement; core: SVGCircleElement }>();
    for (const n of nodes) {
      const g = document.createElementNS(NS, "g");
      const halo = document.createElementNS(NS, "circle");
      halo.setAttribute("cx", String(n.x));
      halo.setAttribute("cy", String(n.y));
      halo.setAttribute("r", "12");
      halo.setAttribute("fill", "#477dfb");
      halo.setAttribute("opacity", "0.12");
      halo.style.transition = "r 0.35s ease, opacity 0.35s ease";

      const core = document.createElementNS(NS, "circle");
      core.setAttribute("cx", String(n.x));
      core.setAttribute("cy", String(n.y));
      core.setAttribute("r", "6");
      core.setAttribute("fill", "#477dfb");
      core.setAttribute("stroke", "#ffffff");
      core.setAttribute("stroke-width", "2");
      core.style.transition = "r 0.35s ease, fill 0.35s ease";

      g.appendChild(halo);
      g.appendChild(core);
      nodesLayer.appendChild(g);
      nodeEls.set(n.id, { group: g, halo, core });
    }

    const fitnessScores = ["64.2%", "76.8%", "88.5%", "95.4%"];
    let genIndex = 0;

    function applyGenStyle(idx: number) {
      const g = idx % 4;
      genLabel.textContent = `GEN 0${g + 1}`;
      fitnessLabel.textContent = fitnessScores[g];

      for (const e of edgeDefs) {
        const w = e.weights[g];
        const line = e.el!;
        if (w === 0) {
          line.setAttribute("stroke", "#9ca3af");
          line.setAttribute("stroke-width", "1");
          line.setAttribute("stroke-dasharray", "3 4");
          line.setAttribute("opacity", "0.16");
        } else if (w === 1) {
          line.setAttribute("stroke", "#7aa2f7");
          line.setAttribute("stroke-width", "1.3");
          line.removeAttribute("stroke-dasharray");
          line.setAttribute("opacity", "0.38");
        } else if (w === 2) {
          line.setAttribute("stroke", "#477dfb");
          line.setAttribute("stroke-width", "2.1");
          line.removeAttribute("stroke-dasharray");
          line.setAttribute("opacity", "0.72");
        } else {
          line.setAttribute("stroke", "url(#edge-active)");
          line.setAttribute("stroke-width", "2.8");
          line.removeAttribute("stroke-dasharray");
          line.setAttribute("opacity", "0.96");
        }
      }
    }

    function pulseNode(nodeId: string, color = "#477dfb") {
      const item = nodeEls.get(nodeId);
      if (!item) return;
      item.halo.setAttribute("r", "16");
      item.halo.setAttribute("opacity", "0.32");
      item.core.setAttribute("r", "7.5");
      item.core.setAttribute("fill", color);
      setTimeout(() => {
        item.halo.setAttribute("r", "12");
        item.halo.setAttribute("opacity", "0.14");
        item.core.setAttribute("r", "6");
        item.core.setAttribute("fill", "#477dfb");
      }, 320);
    }

    function spawnEdgeParticles(layerIdx: number, gen: number) {
      const g = gen % 4;
      const active = edgeDefs.filter((e) => e.from.layer === layerIdx && e.weights[g] >= 2);
      for (const e of active) {
        const dot = document.createElementNS(NS, "circle");
        dot.setAttribute("r", e.weights[g] === 3 ? "3.6" : "2.8");
        dot.setAttribute("fill", "#477dfb");
        pulsesLayer.appendChild(dot);

        const start = performance.now();
        const dur = 420;
        function step(now: number) {
          const t = Math.min(1, (now - start) / dur);
          const x = e.from.x + (e.to.x - e.from.x) * t;
          const y = e.from.y + (e.to.y - e.from.y) * t;
          dot.setAttribute("cx", String(x));
          dot.setAttribute("cy", String(y));
          if (t < 1) {
            requestAnimationFrame(step);
          } else {
            dot.remove();
            pulseNode(e.to.id, "#7aa2f7");
          }
        }
        requestAnimationFrame(step);
      }
    }

    applyGenStyle(0);

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!prefersReducedMotion) {
      function runCycle() {
        phaseLabel.textContent = "FORWARD · EVAL";
        feedbackArc1.classList.remove("is-evolving");
        feedbackArc2.classList.remove("is-evolving");

        nodes.filter((n) => n.layer === 0).forEach((n) => pulseNode(n.id));
        spawnEdgeParticles(0, genIndex);

        setTimeout(() => spawnEdgeParticles(1, genIndex), 420);
        setTimeout(() => spawnEdgeParticles(2, genIndex), 840);

        setTimeout(() => {
          phaseLabel.textContent = "SELF-EVOLVE ↻";
          feedbackArc1.classList.add("is-evolving");
          feedbackArc2.classList.add("is-evolving");
          genIndex = (genIndex + 1) % 4;
          applyGenStyle(genIndex);
          nodes
            .filter((n) => n.layer === 1 || n.layer === 2)
            .forEach((n) => pulseNode(n.id, "#7aa2f7"));
        }, 1350);
      }

      runCycle();
      setInterval(runCycle, 2400);
    }
  }
</script>
