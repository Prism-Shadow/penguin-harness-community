---
import type { Locale } from "../shared/i18n";
import { COMMITTEE_GROUPS } from "../shared/community";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const COPY = {
  zh: {
    title: "RSI 社区委员会",
  },
  en: {
    title: "RSI Community Committee",
  },
}[locale];
---

<div class="mx-auto w-full max-w-3xl px-6 py-12">
  <header class="pb-10">
    <h1 class="text-4xl font-semibold tracking-tight text-gray-950 dark:text-white">
      {COPY.title}
    </h1>
  </header>

  <div class="space-y-12">
    {
      COMMITTEE_GROUPS.map((group) => (
        <section>
          <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-gray-200 pt-5 dark:border-gray-800">
            <h2 class="text-xl font-medium text-gray-950 dark:text-white">
              {group.title[locale]}
            </h2>
          </div>

          <ul class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 md:grid-cols-3">
            {group.members.map((member) => (
              <li>
                <a
                  href={member.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-3 py-1"
                >
                  <div class="h-10 w-10 shrink-0 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-900">
                    <img
                      src="/avatar-default.svg"
                      alt={member.name}
                      loading="lazy"
                      width="40"
                      height="40"
                      class="h-full w-full object-cover"
                    />
                  </div>
                  <div class="min-w-0">
                    <p class="truncate text-sm font-medium text-gray-950 transition-colors group-hover:text-brand-600 dark:text-gray-100 dark:group-hover:text-brand-400">
                      {member.name}
                    </p>
                    <p class="truncate text-xs text-gray-500 dark:text-gray-400">
                      {member.direction[locale]}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>
