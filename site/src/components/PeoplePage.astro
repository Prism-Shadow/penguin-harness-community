---
import type { Locale } from "../shared/i18n";
import {
  COMMITTEE_GROUPS,
  OPEN_SOURCE_CONTRIBUTORS,
  computeContributorRankings,
} from "../shared/community";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { monthly: monthlyRows, allTime: allTimeRows } = computeContributorRankings();

// Build 3 staggered rows with rotated starting offsets so adjacent rows never align vertically
const BASE_HANDLES = OPEN_SOURCE_CONTRIBUTORS.length > 0 ? OPEN_SOURCE_CONTRIBUTORS : ["hiyouga"];
const REPEAT_PER_HALF = Math.max(1, Math.ceil(12 / BASE_HANDLES.length));
const WALL_ROWS: string[][] = [0, 1, 2].map((rowIdx) => {
  const offset = Math.floor((rowIdx * BASE_HANDLES.length) / 3) || (rowIdx * 2) % BASE_HANDLES.length;
  const rotated = [...BASE_HANDLES.slice(offset), ...BASE_HANDLES.slice(0, offset)];
  return Array.from({ length: REPEAT_PER_HALF }, () => rotated).flat();
});

const COPY = {
  zh: {
    title: "成员",
    committeeHeading: "RSI 社区委员会",
    committeeIntro:
      "为打造国际知名的 Agent-native 与 RSI-native 开源社区，委员会共同承担两项核心事务：一是在任务板（/quests/）发布与审核前沿研究课题，保障社区质量；二是探讨 RSI 社区运作机制、链接外部资源并邀请更多同仁加入。委员会成员享有每人每月 1,000 元固定激励（以 Token 额度、算力券形式发放），方向涵盖 Benchmark、算法、Harness、AI4S 等并持续扩展，欢迎在",
    wechatBtn: "社区微信群",
    committeeIntroSuffix: "申请加入。",
    leaderboardHeading: "贡献榜",
    leaderboardIntro:
      "每月 5 日按上月完成任务获得的经验值（EXP）统一结算并发放 Token 额度与算力券。每 1 EXP 直接兑换 1 元额度，当月前五名额外奖励 800 / 400 / 200 / 100 / 50 元。",
    tabMonthly: "当月贡献榜",
    tabAllTime: "总贡献榜",
    colRank: "排名",
    colMember: "成员",
    colExp: "经验值 (EXP)",
    colReward: "当月激励",
    empty: "暂无上榜记录",
    ossWallHeading: "开源贡献名单",
    ossWallIntro: "感谢所有为 PenguinHarness 社区生态提交代码、基准与评测的开源贡献者。",
  },
  en: {
    title: "People",
    committeeHeading: "RSI Community Committee",
    committeeIntro:
      "To build an internationally recognized Agent-native and RSI-native open community, the Committee leads two core missions: (1) publishing and reviewing frontier research topics on the Task Board (/quests/) to uphold community quality, and (2) shaping community governance, connecting external resources, and welcoming global collaborators. Members receive a fixed ¥1,000 RMB / month incentive (in Token credits and compute vouchers). Tracks cover Benchmark, Algorithm, Harness, AI4S, and more — apply via the ",
    wechatBtn: "WeChat Group",
    committeeIntroSuffix: ".",
    leaderboardHeading: "Contributor Leaderboard",
    leaderboardIntro:
      "Rewards for the previous month are settled and distributed on the 5th of each month in Token credits and compute vouchers. Every 1 EXP converts 1:1 to ¥1 RMB, and the monthly Top 5 receive an extra ¥800 / ¥400 / ¥200 / ¥100 / ¥50 bonus.",
    tabMonthly: "Monthly Leaderboard",
    tabAllTime: "All-Time Leaderboard",
    colRank: "Rank",
    colMember: "Member",
    colExp: "EXP",
    colReward: "Monthly Reward",
    empty: "No entries yet",
    ossWallHeading: "Open-Source Contributors",
    ossWallIntro:
      "Thanks to everyone who has contributed code, benchmarks, and evaluations across the PenguinHarness ecosystem.",
  },
}[locale];
---

<div class="mx-auto w-full max-w-3xl px-6 py-12" data-people-root>
  <header class="pb-8">
    <h1 class="text-4xl font-semibold tracking-tight text-gray-950 dark:text-white">
      {COPY.title}
    </h1>
  </header>

  <!-- Part 1: RSI Community Committee -->
  <section>
    <div class="border-t border-gray-200 pt-6 dark:border-gray-800">
      <h2 class="text-2xl font-medium text-gray-950 dark:text-white">
        {COPY.committeeHeading}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
        {COPY.committeeIntro}
        <button
          type="button"
          data-wechat-trigger
          class="cursor-pointer font-medium text-brand-600 underline decoration-brand-300 underline-offset-2 hover:text-brand-500 dark:text-brand-400 dark:decoration-brand-700"
        >
          {COPY.wechatBtn}
        </button>
        {COPY.committeeIntroSuffix}
      </p>
    </div>

    <div class="mt-8 space-y-10">
      {
        COMMITTEE_GROUPS.map((group) => (
          <div>
            <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-gray-200/80 pt-4 dark:border-gray-800/80">
              <h3 class="text-lg font-medium text-gray-950 dark:text-white">
                {group.title[locale]}
              </h3>
            </div>

            <ul class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 md:grid-cols-3">
              {group.members.map((member) => (
                <li>
                  <a
                    href={member.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-3 py-1"
                  >
                    <div class="h-10 w-10 shrink-0 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-900">
                      <img
                        src={member.avatar ?? "/avatar-default.svg"}
                        alt={member.name}
                        loading="lazy"
                        width="40"
                        height="40"
                        class="h-full w-full object-cover"
                      />
                    </div>
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium text-gray-950 transition-colors group-hover:text-brand-600 dark:text-gray-100 dark:group-hover:text-brand-400">
                        {member.name}
                      </p>
                      <div class="mt-1 flex flex-wrap gap-1">
                        {member.tags.map((t) => (
                          <span class="rounded bg-gray-100 px-1.5 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
                            {t[locale]}
                          </span>
                        ))}
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Part 2: Contributor Leaderboard (Monthly & All-Time) -->
  <section class="mt-16 border-t border-gray-200 pt-8 dark:border-gray-800">
    <h2 class="text-2xl font-medium text-gray-950 dark:text-white">
      {COPY.leaderboardHeading}
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
      {COPY.leaderboardIntro}
    </p>

    <!-- Tabs: Monthly vs All-Time -->
    <nav class="mt-6 flex gap-6 border-b border-gray-200 dark:border-gray-800" data-rank-tabs>
      <button
        type="button"
        data-rank-tab="monthly"
        class="rank-tab is-active -mb-px cursor-pointer border-b-2 py-2.5 text-sm font-medium transition-colors"
      >
        {COPY.tabMonthly}
      </button>
      <button
        type="button"
        data-rank-tab="alltime"
        class="rank-tab -mb-px cursor-pointer border-b-2 py-2.5 text-sm font-medium transition-colors"
      >
        {COPY.tabAllTime}
      </button>
    </nav>

    <!-- Monthly Table -->
    <div data-rank-panel="monthly" class="mt-2 overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-xs text-gray-400 dark:border-gray-800 dark:text-gray-500">
            <th class="w-12 py-2.5 pr-4 text-left font-normal">{COPY.colRank}</th>
            <th class="py-2.5 pr-4 text-left font-normal">{COPY.colMember}</th>
            <th class="py-2.5 pl-4 text-right font-normal">{COPY.colExp}</th>
            <th class="py-2.5 pl-4 text-right font-normal">{COPY.colReward}</th>
          </tr>
        </thead>
        <tbody>
          {
            monthlyRows.length === 0 ? (
              <tr class="border-b border-gray-200 dark:border-gray-800">
                <td colspan="4" class="py-8 text-center text-xs text-gray-400 dark:text-gray-500">
                  {COPY.empty}
                </td>
              </tr>
            ) : (
              monthlyRows.map((row) => (
                <tr class="border-b border-gray-200 dark:border-gray-800">
                  <td class="mono py-3 pr-4 text-xs text-gray-400">#{row.rank}</td>
                  <td class="py-3 pr-4">
                    <a
                      href={row.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-gray-950 hover:underline dark:text-gray-100"
                    >
                      {row.name}
                    </a>
                    <span class="mono ml-1.5 text-xs text-gray-400">@{row.handle}</span>
                  </td>
                  <td class="mono py-3 pl-4 text-right font-semibold text-brand-700 dark:text-brand-400">
                    {row.exp} EXP
                  </td>
                  <td class="mono py-3 pl-4 text-right font-semibold text-gray-950 dark:text-gray-100">
                    ¥{row.totalEstimatedRmb}
                  </td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>

    <!-- All-Time Table -->
    <div data-rank-panel="alltime" class="mt-2 hidden overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-xs text-gray-400 dark:border-gray-800 dark:text-gray-500">
            <th class="w-12 py-2.5 pr-4 text-left font-normal">{COPY.colRank}</th>
            <th class="py-2.5 pr-4 text-left font-normal">{COPY.colMember}</th>
            <th class="py-2.5 pl-4 text-right font-normal">{COPY.colExp}</th>
          </tr>
        </thead>
        <tbody>
          {
            allTimeRows.length === 0 ? (
              <tr class="border-b border-gray-200 dark:border-gray-800">
                <td colspan="3" class="py-8 text-center text-xs text-gray-400 dark:text-gray-500">
                  {COPY.empty}
                </td>
              </tr>
            ) : (
              allTimeRows.map((row) => (
                <tr class="border-b border-gray-200 dark:border-gray-800">
                  <td class="mono py-3 pr-4 text-xs text-gray-400">#{row.rank}</td>
                  <td class="py-3 pr-4">
                    <a
                      href={row.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-gray-950 hover:underline dark:text-gray-100"
                    >
                      {row.name}
                    </a>
                    <span class="mono ml-1.5 text-xs text-gray-400">@{row.handle}</span>
                  </td>
                  <td class="mono py-3 pl-4 text-right font-semibold text-brand-700 dark:text-brand-400">
                    {row.exp} EXP
                  </td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- Part 3: Open-Source Contributors Name Wall -->
  <section class="mt-16 border-t border-gray-200 pt-8 dark:border-gray-800">
    <h2 class="text-2xl font-medium text-gray-950 dark:text-white">
      {COPY.ossWallHeading}
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
      {COPY.ossWallIntro}
    </p>

    <div class="oss-wall-stage relative mt-5 overflow-hidden rounded-xl border border-gray-200/90 bg-gradient-to-b from-gray-50/80 via-white to-gray-50/80 py-5 shadow-2xs dark:border-gray-800/90 dark:from-gray-900/50 dark:via-gray-950 dark:to-gray-900/50">
      <div class="oss-wall relative z-10 space-y-2.5 overflow-hidden py-0.5">
        {
          WALL_ROWS.map((rowHandles, rowIdx) => (
            <div class="oss-wall-row overflow-hidden py-0.5">
              <div
                class={`oss-wall-track ${
                  rowIdx % 2 === 1 ? "oss-wall-track-reverse" : ""
                }`}
                style={`--wall-duration: ${Math.max(120, rowHandles.length * 6) + rowIdx * 14}s;`}
              >
                {[0, 1].map((dup) => (
                  <div
                    class="oss-wall-group flex shrink-0 items-center gap-2 pr-2"
                    aria-hidden={dup === 1 ? "true" : undefined}
                  >
                    {rowHandles.map((handle) => (
                      <a
                        href={`https://github.com/${handle}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        tabindex={dup === 1 ? -1 : undefined}
                        class="group mono inline-flex items-center gap-1.5 rounded-lg border border-gray-200/90 bg-white/95 px-2.5 py-1 text-xs font-medium text-gray-800 shadow-2xs backdrop-blur-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-500 hover:bg-white hover:text-brand-600 hover:shadow-xs dark:border-gray-800 dark:bg-gray-900/90 dark:text-gray-200 dark:hover:border-brand-400 dark:hover:bg-gray-900 dark:hover:text-brand-300"
                      >
                        <svg
                          viewBox="0 0 16 16"
                          aria-hidden="true"
                          class="h-3.5 w-3.5 shrink-0 fill-gray-400 transition-colors group-hover:fill-brand-500 dark:fill-gray-500 dark:group-hover:fill-brand-400"
                        >
                          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                        </svg>
                        <span>@{handle}</span>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</div>

<style>
  .rank-tab {
    border-color: transparent;
    color: #6b7280;
  }
  .rank-tab:hover {
    color: #111827;
  }
  :global(.dark) .rank-tab:hover {
    color: #f9fafb;
  }
  .rank-tab.is-active {
    border-color: #111827;
    color: #111827;
  }
  :global(.dark) .rank-tab.is-active {
    border-color: #f9fafb;
    color: #f9fafb;
  }

  .oss-wall-stage {
    background-image: radial-gradient(rgba(107, 114, 128, 0.14) 1px, transparent 1px);
    background-size: 18px 18px;
  }

  :global(.dark) .oss-wall-stage {
    background-image: radial-gradient(rgba(156, 163, 175, 0.12) 1px, transparent 1px);
  }

  .oss-wall {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }

  .oss-wall-track {
    display: flex;
    width: max-content;
    animation: oss-wall-scroll-left var(--wall-duration, 30s) linear infinite;
  }

  .oss-wall-track-reverse {
    animation-name: oss-wall-scroll-right;
  }

  .oss-wall-row:hover .oss-wall-track {
    animation-play-state: paused;
  }

  @keyframes oss-wall-scroll-left {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes oss-wall-scroll-right {
    0% {
      transform: translate3d(-50%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oss-wall-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
    }
    .oss-wall-group[aria-hidden="true"] {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-people-root]");
  if (root) {
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-rank-tab]");
    const panels = root.querySelectorAll<HTMLElement>("[data-rank-panel]");
    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.rankTab;
        tabs.forEach((b) => b.classList.toggle("is-active", b === btn));
        panels.forEach((p) => p.classList.toggle("hidden", p.dataset.rankPanel !== target));
      });
    });
  }
</script>
