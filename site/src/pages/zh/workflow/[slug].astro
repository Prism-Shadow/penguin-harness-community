---
import DocPage from "../../../layouts/DocPage.astro";
import { docFile } from "../../../shared/docs";
import { ALL_WORKFLOW, WORKFLOW_INDEX } from "../../../shared/site";

export function getStaticPaths() {
  return ALL_WORKFLOW.filter((doc) => doc !== WORKFLOW_INDEX).map((doc) => ({
    params: { slug: doc.slug },
    props: { doc, page: docFile("zh", doc) },
  }));
}

const { doc, page } = Astro.props;
---

<DocPage locale="zh" doc={doc} page={page} />
